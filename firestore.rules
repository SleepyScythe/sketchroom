rules_version = '2';

// Sketchroom Firestore rules. Paste into Firebase console > Firestore Database > Rules, then Publish.
// Free library (brushes, fonts): everyone reads, admins write.
// users/{uid}/...: private to that signed-in user, except that friends can read library items that aren't private.
// admins/{uid}: created by hand in the console. Nobody can write it from the app.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    // The signed-in person is in uid's friends list (it is only ever written when uid accepted, or asked for, the friendship).
    function isFriendOf(uid) { return signedIn() && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)); }
    function validBrush(d) {
      return d.keys().hasOnly(['name', 'params', 'at', 'by'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.params is map && d.params.size() <= 40
        && d.at is number;
    }
    function validItem(d) {
      return d.keys().hasOnly(['type', 'name', 'parent', 'created', 'updated', 'w', 'h', 'px', 'layers', 'active', 'count', 'thumb', 'private'])
        && d.type in ['project', 'folder', 'image']
        && (!('private' in d) || d.private is bool)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.parent is string && d.parent.size() <= 40
        && d.created is number && d.updated is number
        && (!('layers' in d) || (d.layers is list && d.layers.size() <= 100))
        && (!('thumb' in d) || (d.thumb is string && d.thumb.size() <= 120000))
        && (!('w' in d) || (d.w is int && d.w >= 1 && d.w <= 4096))
        && (!('h' in d) || (d.h is int && d.h >= 1 && d.h <= 4096));
    }
    function validFont(d) {
      return d.keys().hasOnly(['family', 'at', 'by'])
        && d.family is string && d.family.size() >= 2 && d.family.size() <= 40
        && d.at is number;
    }

    match /brushes/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validBrush(request.resource.data);
      allow delete: if isAdmin();
    }
    match /fonts/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validFont(request.resource.data);
      allow delete: if isAdmin();
    }
    match /users/{uid}/brushes/{id} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid) && validBrush(request.resource.data);
    }
    match /users/{uid}/fonts/{id} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid) && validFont(request.resource.data);
    }
    // Which "What's new" notes this person has seen, so they only pop up once per account.
    match /users/{uid}/settings/news {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['seen', 'at'])
        && request.resource.data.seen is string && request.resource.data.seen.size() <= 40
        && request.resource.data.at is number;
    }
    match /users/{uid}/settings/colors {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['colors', 'at'])
        && request.resource.data.colors is list && request.resource.data.colors.size() <= 60
        && request.resource.data.at is number;
    }
    // Drawing together: shares/{owner}_{imageId} = { owner, image, members, name, at }. Members are up to 5 of the owner's
    // friends (checked one by one, since rules have no loops). Members can open that image, draw on it and save it.
    function isMyFriend(m) { return exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(m)); }
    function friendsOk(ms) {
      return (ms.size() < 1 || isMyFriend(ms[0])) && (ms.size() < 2 || isMyFriend(ms[1])) && (ms.size() < 3 || isMyFriend(ms[2]))
        && (ms.size() < 4 || isMyFriend(ms[3])) && (ms.size() < 5 || isMyFriend(ms[4]));
    }
    function isShareMember(sid) {
      let s = get(/databases/$(database)/documents/shares/$(sid)).data;
      return signedIn() && (s.owner == request.auth.uid || request.auth.uid in s.members);
    }
    // The library: projects, folders and images. An image's layer PNGs are in Cloud Storage (see storage.rules).
    // Friends can read items whose private flag is false (their queries must ask for private == false).
    // People an image is shared with can read it and save their drawing into it (layers, thumbnail and these only).
    match /users/{uid}/items/{id} {
      allow read: if isUser(uid) || (isFriendOf(uid) && resource.data.private == false) || isShareMember(uid + '_' + id);
      allow delete: if isUser(uid);
      allow create: if isUser(uid) && validItem(request.resource.data);
      allow update: if validItem(request.resource.data) && (isUser(uid)
        || (isShareMember(uid + '_' + id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['layers', 'active', 'count', 'thumb', 'updated'])));
    }
    match /shares/{sid} {
      allow read: if signedIn() && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.members);
      allow create, update: if signedIn() && sid == request.auth.uid + '_' + request.resource.data.image
        && request.resource.data.keys().hasOnly(['owner', 'image', 'members', 'name', 'at'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.image is string && request.resource.data.image.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.at is number
        && request.resource.data.members is list && request.resource.data.members.size() <= 5
        && !(request.auth.uid in request.resource.data.members)
        && friendsOk(request.resource.data.members)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/items/$(request.resource.data.image));
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      // The live changes (see js/live.js): finished pixels (px), the layer list (layers) and strokes being drawn (stroke).
      // Written by the people in the share, stamped with the server time.
      match /ops/{opId} {
        allow read: if isShareMember(sid);
        allow create: if isShareMember(sid) && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.keys().hasOnly(['by', 'at', 'seq', 'cid', 'kind', 'layer', 'x', 'y', 'w', 'h', 'patch', 'mask', 'full', 'list', 'deleted', 'sk', 'pts', 'params', 'color', 'first', 'done', 'cancel'])
          && request.resource.data.kind in ['px', 'layers', 'stroke'];
        allow delete: if signedIn() && (resource.data.by == request.auth.uid
          || get(/databases/$(database)/documents/shares/$(sid)).data.owner == request.auth.uid);
      }
    }
    // Friends: users/{uid}/friends/{other} = { since }. Accepting a request writes both sides and deletes the request
    // in one batch. Each side may only be created while that request exists (exists() sees the data before the batch)
    // and only if the same batch deletes it, so nobody can add themselves to someone else's list.
    match /users/{uid}/friends/{other} {
      allow read: if isUser(uid);
      allow create: if signedIn() && uid != other
        && request.resource.data.keys().hasOnly(['since']) && request.resource.data.since is number
        && ((request.auth.uid == uid
              && exists(/databases/$(database)/documents/friendRequests/$(other + '_' + uid))
              && !existsAfter(/databases/$(database)/documents/friendRequests/$(other + '_' + uid)))
          || (request.auth.uid == other
              && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + other))
              && !existsAfter(/databases/$(database)/documents/friendRequests/$(uid + '_' + other))));
      // Either friend can end the friendship, on both sides.
      allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == other);
    }
    // Friend requests: friendRequests/{from}_{to} = { from, to, at }. Only the two people involved can see or delete one.
    match /friendRequests/{id} {
      allow read, delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.at is number
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.to))
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(request.resource.data.to));
    }
    match /users/{uid}/uploadedFonts/{id} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['family', 'data', 'at'])
        && request.resource.data.family is string && request.resource.data.family.size() >= 2 && request.resource.data.family.size() <= 40
        && request.resource.data.data is string && request.resource.data.data.size() <= 960000
        && request.resource.data.at is number;
    }
    // Brushes suggested for the free library. The document id is "<uid>_<brushId>", so each brush can be suggested once.
    match /requests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
      allow create, update: if signedIn() && id == request.auth.uid + '_' + request.resource.data.brushId
        && request.resource.data.keys().hasOnly(['name', 'params', 'at', 'by', 'byName', 'brushId'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.params is map && request.resource.data.params.size() <= 40
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 80
        && request.resource.data.brushId is string && request.resource.data.brushId.size() <= 40
        && request.resource.data.at is number;
      allow delete: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
    }
    // Profiles: readable by signed-in people, written only by their owner, and the username must be reserved for them
    // in usernames/{name} by the same batch (getAfter sees the batch's result).
    function validProfile(d) {
      return d.keys().hasOnly(['username', 'displayName', 'bio', 'pronouns', 'location', 'links', 'avatar', 'color', 'joined', 'updated'])
        && d.username is string && d.username.matches('^[a-z0-9_.]{3,20}$')
        && d.displayName is string && d.displayName.size() <= 40
        && d.bio is string && d.bio.size() <= 200
        && d.pronouns is string && d.pronouns.size() <= 24
        && d.location is string && d.location.size() <= 40
        && d.links is list && d.links.size() <= 3
        && d.avatar is string && d.avatar.size() <= 80000
        && d.color is string && d.color.size() <= 7
        && d.joined is number && d.updated is number;
    }
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isUser(uid) && validProfile(request.resource.data)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow delete: if isUser(uid);
    }
    // usernames/{name} = { uid }. Create only (a taken name can't be overwritten), and only for the name in your own profile.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && name.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == name;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid))
            || getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username != name);
    }
    // The contact form. Any signed-in person can send; only admins can read, mark read or delete.
    match /messages/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'topic', 'text', 'contact', 'at', 'read'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string && request.resource.data.username.size() <= 20
        && request.resource.data.topic in ['report', 'privacy', 'bug', 'other']
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 120
        && request.resource.data.at is number && request.resource.data.read == false;
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
    match /admins/{uid} {
      allow read: if isUser(uid);
    }
  }
}
